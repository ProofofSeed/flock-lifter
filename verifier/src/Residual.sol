            }
            function mul256(x, y, t) -> o {
                let x0 := and(x, 0xffffffffffffffffffffffffffffffff)
                let x1 := shr(128, x)
                let y0 := and(y, 0xffffffffffffffffffffffffffffffff)
                let y1 := shr(128, y)
                tab4(x0, t)
                let p0 := scan(t, y0)
                tab4(x1, t)
                let p1 := scan(t, y1)
                tab4(xor(x0, x1), t)
                let p2 := scan(t, xor(y0, y1))
                o := or(shl(128, red(xor(p2, p0))), red(xor(xor(p0, shr(1, p1)), mul(and(p1, 1), 0x80000000000000000000000000000043))))
            }
            function by128(x, t) -> o {
                o := or(shl(128, red(scan(t, shr(128, x)))), red(scan(t, and(x, 0xffffffffffffffffffffffffffffffff))))
            }
            function wk(sub_, row, bits) -> o {
                for { let b := row } shr(b, bits) { b := add(b, 1) } {
                    if and(shr(b, bits), 1) {
                        o := xor(o, shr(128, mload(add(sub_, mul(16, add(mul(row, 32), b))))))
                    }
                }
            }
            function entries(cx, k_, fk_) -> gr {
                let d := mload(add(cx, 0x40))
                let sub_ := mload(add(cx, 0x80))
                let sc := mload(add(cx, 0xa0))
                let span := 0
                if gt(d, k_) { span := sub(d, k_) }
                gr := shr(3, add(span, 7))
                tab4(and(fk_, 0xffffffffffffffffffffffffffffffff), add(sc, S_T))
                tab4(shr(128, fk_), add(sc, S_T2))
                let vals := add(sc, S_VALS)
                for { let b := 0 } lt(b, shl(3, gr)) { b := add(b, 1) } {
                    let v := 0
                    if lt(b, span) {
                        let s := shr(128, mload(add(sub_, mul(16, add(mul(k_, 32), add(k_, b))))))
                        v := or(shl(128, red(scan(add(sc, S_T2), s))), red(scan(add(sc, S_T), s)))
                    }
                    mstore(add(vals, shl(5, b)), v)
                }
            }
            function applyK(cx, qd, pd, count, k_, base_, groups_) {
                let sc := mload(add(cx, 0xa0))
                let t := add(sc, S_T)
                for { let i := 0 } lt(i, count) { i := add(i, 1) } {
                    let m := shr(k_, mload(add(qd, shl(5, i))))
                    let v := base_
                    for { let g := 0 } lt(g, groups_) { g := add(g, 1) } {
                        v := xor(v, mload(add(sc, add(shl(13, g), shl(5, and(shr(shl(3, g), m), 0xff))))))
                    }
                    let slot := add(pd, shl(5, i))
                    mstore(slot, mul256(mload(slot), v, t))
                }
            }
            function plainK(cx, qd, pd, count, k_, fk_) {
                let sub_ := mload(add(cx, 0x80))
                let t := add(mload(add(cx, 0xa0)), S_T)
                for { let i := 0 } lt(i, count) { i := add(i, 1) } {
                    let slot := add(pd, shl(5, i))
                    tab4(xor(1, wk(sub_, k_, mload(add(qd, shl(5, i))))), t)
                    mstore(slot, mul256(mload(slot), xor(1, by128(fk_, t)), t))
                }
            }
            function stage(cx, src, dst, j) {
                let f := mload(add(cx, 0x20))
                let hb := mload(add(cx, 0xc0))
                let t := add(mload(add(cx, 0xa0)), S_T)
                let keys := 1
                if gt(hb, j) { keys := shl(sub(hb, j), 1) }
                let half := shl(j, 1)
                for { let key := 0 } lt(key, keys) { key := add(key, 1) } {
                    tab4(wk(mload(add(cx, 0x80)), add(f, j), shl(add(f, j), key)), t)
                    let from := add(src, shl(5, mul(shr(1, key), shl(1, half))))
                    let to := add(dst, shl(5, mul(key, half)))
                    for { let o := 0 } lt(o, shl(5, half)) { o := add(o, 0x20) } {
                        mstore(add(to, o), xor(mload(add(from, o)), by128(mload(add(add(from, o), shl(5, half))), t)))
                    }
                }
            }
            function init(cx, dst, md) {
                let hb := mload(add(cx, 0xc0))
                let ext := mload(add(cx, 0x60))
                let keys := 1
                if gt(hb, ext) { keys := shl(sub(hb, ext), 1) }
                let width := shl(ext, 32)
                for { let key := 0 } lt(key, keys) { key := add(key, 1) } {
                    let to := add(dst, mul(key, width))
                    for { let o := 0 } lt(o, width) { o := add(o, 0x20) } {
                        mstore(add(to, o), mload(add(md, o)))
                    }
                }
            }
            function tree(cx, md) -> src {
                let ext := mload(add(cx, 0x60))
                let hb := mload(add(cx, 0xc0))
                let size := shl(ext, 32)
                if gt(hb, ext) { size := shl(hb, 32) }
                src := add(mload(add(cx, 0xa0)), S_BUF)
                let dst := add(src, size)
                init(cx, src, md)
                for { let j := ext } j { } {
                    j := sub(j, 1)
                    stage(cx, src, dst, j)
                    let tmp := src
                    src := dst
                    dst := tmp
                }
            }
            function level(cx, v, j, bits) {
                let f := mload(add(cx, 0x20))
                let t := add(mload(add(cx, 0xa0)), S_T)
                let half := shl(j, 1)
                tab4(wk(mload(add(cx, 0x80)), add(f, j), bits), t)
                for { let y := 0 } lt(y, half) { y := add(y, 1) } {
                    let slot := add(v, shl(5, y))
                    mstore(slot, xor(mload(slot), by128(mload(add(v, shl(5, add(y, half)))), t)))
                }
            }
            function suffix(cx, md, len, q_, prefix_) -> o {
                let v := add(mload(add(cx, 0xa0)), S_VALS)
                for { let k := 0 } lt(k, shl(5, len)) { k := add(k, 0x20) } {
                    mstore(add(v, k), mload(add(md, k)))
                }
                for { let j := mload(add(cx, 0x60)) } j { } {
                    j := sub(j, 1)
                    level(cx, v, j, q_)
                }
                o := mul256(mload(v), prefix_, add(mload(add(cx, 0xa0)), S_T))
            }
            let cx := add(ctx, 0x20)
            switch mode
            case 0 { out := entries(cx, a1, a2) }
            case 1 { applyK(cx, add(qs, 0x20), add(p, 0x20), mload(qs), a1, a2, a3) }
            case 2 { plainK(cx, add(qs, 0x20), add(p, 0x20), mload(qs), a1, a2) }
            case 3 { out := tree(cx, add(mu, 0x20)) }
            default { out := suffix(cx, add(mu, 0x20), mload(mu), a1, a2) }
        }
    }
}
