    /// Writes the pure tensors of `Π_{i < a} (1 ⊗ gw[i] + gq[i] ⊗ 1)`: left factors `A_S` at `RA`,
    /// right factors `Π_{i ∈ S} gw[i]` at `RB`, and the `A_S` padded to 32 values.
    function _rankProducts(uint256 r, uint256[] memory gq, uint256[] memory gw, uint256 a) private pure {
        assembly ("memory-safe") {
            function red(v) -> o {
                let h := shr(128, v)
                o := xor(and(v, 0xffffffffffffffffffffffffffffffff), xor(h, xor(shl(1, h), xor(shl(2, h), shl(7, h)))))
                h := shr(128, o)
                o := xor(and(o, 0xffffffffffffffffffffffffffffffff), xor(h, xor(shl(1, h), xor(shl(2, h), shl(7, h)))))
            }
            function tab4(x, t) {
                let x2 := shl(1, x)
                let x3 := xor(x2, x)
                let x4 := shl(2, x)
                let x8 := shl(3, x)
                let x12 := xor(x8, x4)
                mstore(t, 0)
                mstore(add(t, 0x20), x)
                mstore(add(t, 0x40), x2)
                mstore(add(t, 0x60), x3)
                mstore(add(t, 0x80), x4)
                mstore(add(t, 0xa0), xor(x4, x))
                mstore(add(t, 0xc0), xor(x4, x2))
                mstore(add(t, 0xe0), xor(x4, x3))
                mstore(add(t, 0x100), x8)
                mstore(add(t, 0x120), xor(x8, x))
                mstore(add(t, 0x140), xor(x8, x2))
                mstore(add(t, 0x160), xor(x8, x3))
                mstore(add(t, 0x180), x12)
                mstore(add(t, 0x1a0), xor(x12, x))
                mstore(add(t, 0x1c0), xor(x12, x2))
                mstore(add(t, 0x1e0), xor(x12, x3))
            }
            function scan(t, y) -> o {
                let n := byte(16, y)
                o := xor(shl(4, mload(add(t, shl(5, shr(4, n))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(17, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(18, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(19, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(20, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(21, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(22, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(23, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(24, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(25, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(26, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(27, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(28, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(29, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(30, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
                n := byte(31, y)
                o := xor(xor(shl(8, o), shl(4, mload(add(t, shl(5, shr(4, n)))))), mload(add(t, shl(5, and(n, 15)))))
            }
            function mul256(x, y, t) -> o {
                let x0 := and(x, 0xffffffffffffffffffffffffffffffff)
                let x1 := shr(128, x)
                let y0 := and(y, 0xffffffffffffffffffffffffffffffff)
                let y1 := shr(128, y)
                tab4(x0, t)
                let p0 := scan(t, y0)
                tab4(x1, t)
                let p1 := scan(t, y1)
                tab4(xor(x0, x1), t)
                let p2 := scan(t, xor(y0, y1))
                o := or(shl(128, red(xor(p2, p0))), red(xor(xor(p0, shr(1, p1)), mul(and(p1, 1), 0x80000000000000000000000000000043))))
            }
            function look(tab, m) -> o {
                o := xor(mload(add(tab, shl(5, byte(31, m)))), mload(add(tab, add(0x2000, shl(5, byte(30, m))))))
                o := xor(o, xor(mload(add(tab, add(0x4000, shl(5, byte(29, m))))), mload(add(tab, add(0x6000, shl(5, byte(28, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x8000, shl(5, byte(27, m))))), mload(add(tab, add(0xa000, shl(5, byte(26, m)))))))
                o := xor(o, xor(mload(add(tab, add(0xc000, shl(5, byte(25, m))))), mload(add(tab, add(0xe000, shl(5, byte(24, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x10000, shl(5, byte(23, m))))), mload(add(tab, add(0x12000, shl(5, byte(22, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x14000, shl(5, byte(21, m))))), mload(add(tab, add(0x16000, shl(5, byte(20, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x18000, shl(5, byte(19, m))))), mload(add(tab, add(0x1a000, shl(5, byte(18, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x1c000, shl(5, byte(17, m))))), mload(add(tab, add(0x1e000, shl(5, byte(16, m)))))))
            }
            function products(r_, qs, ws, n) {
                let t := add(r_, MT)
                let pa := add(r_, RA)
                let pb := add(r_, RB)
                mstore(pa, 1)
                mstore(pb, 1)
                let top := 0
                for { let s := 1 } lt(s, n) { s := add(s, 1) } {
                    if eq(s, shl(add(top, 1), 1)) { top := add(top, 1) }
                    let low := xor(s, shl(top, 1))
                    mstore(add(pa, shl(5, s)), mul256(mload(add(pa, shl(5, low))), mload(add(qs, shl(5, top))), t))
                    tab4(mload(add(ws, shl(5, top))), t)
                    mstore(add(pb, shl(5, s)), red(scan(t, mload(add(pb, shl(5, low))))))
                }
                for { let s := n } lt(s, 32) { s := add(s, 1) } {
                    mstore(add(pa, shl(5, s)), 0)
                }
            }
            products(r, add(gq, 0x20), add(gw, 0x20), shl(a, 1))
        }
    }

    /// Writes the columns of the rank expansion from the table of its left factors.
    function _rankColumns(uint256 r, uint256 a) private pure {
        assembly ("memory-safe") {
            let n := shl(a, 1)
            let pb := add(r, RB)
            let pw := add(r, RW)
            let sp := add(r, SPREAD)
            for { let g := 0 } lt(g, 16) { g := add(g, 1) } {
                mstore(add(pw, shl(5, g)), 0)
            }
            for { let s := 0 } lt(s, n) { s := add(s, 1) } {
                let v := mload(add(pb, shl(5, xor(sub(n, 1), s))))
                for { let g := 0 } lt(g, 16) { g := add(g, 1) } {
                    let bt := byte(sub(31, g), v)
                    if bt {
                        let slot := add(pw, shl(5, g))
                        mstore(slot, xor(mload(slot), shl(s, mload(add(sp, shl(5, bt))))))
                    }
                }
            }
            let tab := add(r, TA)
            let cc := add(r, CC)
            for { let b := 0 } lt(b, 128) { b := add(b, 1) } {
                let m := shr(shl(5, and(b, 7)), mload(add(pw, shl(5, shr(3, b)))))
                mstore(
                    add(cc, shl(5, b)),
                    xor(
                        xor(mload(add(tab, shl(5, and(m, 0xff)))), mload(add(tab, add(0x2000, shl(5, and(shr(8, m), 0xff)))))),
                        xor(mload(add(tab, add(0x4000, shl(5, and(shr(16, m), 0xff))))), mload(add(tab, add(0x6000, shl(5, and(shr(24, m), 0xff))))))
                    )
                )
            }
        }
    }

    /// Multiplies the tensor by `1 ⊗ w + q ⊗ 1`, with the columns' table already at `TA`.
    function _step(uint256 r, uint256 q, uint256 w) private pure {
        assembly ("memory-safe") {
            function red(v) -> o {
                let h := shr(128, v)
                o := xor(and(v, 0xffffffffffffffffffffffffffffffff), xor(h, xor(shl(1, h), xor(shl(2, h), shl(7, h)))))
                h := shr(128, o)
                o := xor(and(o, 0xffffffffffffffffffffffffffffffff), xor(h, xor(shl(1, h), xor(shl(2, h), shl(7, h)))))
            }
            function hmul(h, y) -> o {
                o := mload(add(h, shl(5, byte(16, y))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(17, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(18, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(19, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(20, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(21, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(22, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(23, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(24, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(25, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(26, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(27, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(28, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(29, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(30, y)))))
                o := xor(shl(8, o), mload(add(h, shl(5, byte(31, y)))))
            }
            function horner(h, a) {
                mstore(h, 0)
                for { let i := 1 } lt(i, 256) { i := add(i, 1) } {
                    mstore(add(h, shl(5, i)), xor(shl(1, mload(add(h, shl(5, shr(1, i))))), mul(and(i, 1), a)))
                }
            }
            function look(tab, m) -> o {
                o := xor(mload(add(tab, shl(5, byte(31, m)))), mload(add(tab, add(0x2000, shl(5, byte(30, m))))))
                o := xor(o, xor(mload(add(tab, add(0x4000, shl(5, byte(29, m))))), mload(add(tab, add(0x6000, shl(5, byte(28, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x8000, shl(5, byte(27, m))))), mload(add(tab, add(0xa000, shl(5, byte(26, m)))))))
                o := xor(o, xor(mload(add(tab, add(0xc000, shl(5, byte(25, m))))), mload(add(tab, add(0xe000, shl(5, byte(24, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x10000, shl(5, byte(23, m))))), mload(add(tab, add(0x12000, shl(5, byte(22, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x14000, shl(5, byte(21, m))))), mload(add(tab, add(0x16000, shl(5, byte(20, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x18000, shl(5, byte(19, m))))), mload(add(tab, add(0x1a000, shl(5, byte(18, m)))))))
                o := xor(o, xor(mload(add(tab, add(0x1c000, shl(5, byte(17, m))))), mload(add(tab, add(0x1e000, shl(5, byte(16, m)))))))
            }
            function masks(v, out) {
                let rv := or(shl(1, and(v, 0x55555555555555555555555555555555)), and(shr(1, v), 0x55555555555555555555555555555555))
                rv := or(shl(2, and(rv, 0x33333333333333333333333333333333)), and(shr(2, rv), 0x33333333333333333333333333333333))
                rv := or(shl(4, and(rv, 0x0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f)), and(shr(4, rv), 0x0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f))
                rv := or(shl(8, and(rv, 0x00ff00ff00ff00ff00ff00ff00ff00ff)), and(shr(8, rv), 0x00ff00ff00ff00ff00ff00ff00ff00ff))
                rv := or(shl(16, and(rv, 0x0000ffff0000ffff0000ffff0000ffff)), and(shr(16, rv), 0x0000ffff0000ffff0000ffff0000ffff))
                rv := or(shl(32, and(rv, 0x00000000ffffffff00000000ffffffff)), and(shr(32, rv), 0x00000000ffffffff00000000ffffffff))
                rv := or(shl(64, and(rv, 0xffffffffffffffff)), shr(64, rv))
                let low := and(rv, 0x7f)
                let m127 := xor(rv, xor(shl(121, low), xor(shl(126, and(low, 3)), shl(127, and(low, 1)))))
                let s := and(shl(1, m127), 0xffffffffffffffffffffffffffffffff)
                let prev := 0
                for { let k := 0 } lt(k, 128) { k := add(k, 1) } {
                    let m := xor(and(shl(1, prev), 0xffffffffffffffffffffffffffffffff), and(shr(k, v), 1))
                    if or(lt(k, 3), eq(k, 7)) { m := xor(m, s) }
                    mstore(add(out, shl(5, k)), m)
                    prev := m
                }
            }
