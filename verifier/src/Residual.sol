    /// `Σ_y μ_y·B[y]` for `B` the basis a level's queried consistency induces at the residual
    /// points, `weights` the `eq` table of its batching point and `fixedPart` its fixed
    /// challenges.
    function consistency(
        uint256 logCols,
        uint256[] memory qs,
        uint256[] memory weights,
        uint256[] memory fixedPart,
        uint256[] memory mu
    ) internal pure returns (uint256 total) {
        uint256 mark;
        assembly ("memory-safe") {
            mark := mload(0x40)
        }
        uint256[] memory ctx = context(logCols, qs, fixedPart.length, mu.length, Constants.SUBSPACE);
        uint256[] memory p = new uint256[](qs.length);
        for (uint256 i = 0; i < qs.length; ++i) {
            p[i] = weights[i];
        }
        for (uint256 k = 0; k < fixedPart.length; ++k) {
            factor(ctx, qs, p, k, fixedPart[k]);
        }
        total = collect(ctx, qs, p, mu);
        assembly ("memory-safe") {
            mstore(0x40, mark)
        }
    }

    /// The working context of one level's consistency evaluation, over the subspace table `table`
    /// (`Constants.SUBSPACE`): `[logCols, f, d, ext, subspace table, scratch, suffix bits]`.
    function context(uint256 logCols, uint256[] memory qs, uint256 f, uint256 points_, bytes memory table)
        internal
        pure
        returns (uint256[] memory ctx)
    {
        uint256 maxQ;
        for (uint256 i = 0; i < qs.length; ++i) {
            if (qs[i] > maxQ) maxQ = qs[i];
        }
        ctx = new uint256[](7);
        ctx[0] = logCols;
        ctx[1] = f;
        while ((maxQ >> ctx[2]) != 0) {
            ++ctx[2];
        }
        while ((1 << ctx[3]) < points_) {
            ++ctx[3];
        }
        ctx[6] = ctx[2] > f ? ctx[2] - f : 0;
        uint256 buf = ctx[6] <= TREE_BITS ? (ctx[6] > ctx[3] ? 1 << ctx[6] : points_) : 0;
        uint256[] memory scratch = new uint256[](S_BUF / 32 + 2 * buf);
        assembly ("memory-safe") {
            mstore(add(ctx, 0xa0), add(table, 0x20))
            mstore(add(ctx, 0xc0), add(scratch, 0x20))
        }
    }

    /// Multiplies each `p[i]` by factor `k`, `1 + fk·(1 + w_k(q_i))`.
    function factor(uint256[] memory ctx, uint256[] memory qs, uint256[] memory p, uint256 k, uint256 fk)
        internal
        pure
    {
        if (qs.length >= 32) {
            uint256 groups = _kernel(0, ctx, qs, p, p, k, fk, 0);
            _build(ctx[5] + S_TAB, ctx[5] + S_VALS, groups);
            _kernel(1, ctx, qs, p, p, k, fk ^ 1, groups);
        } else {
            _kernel(2, ctx, qs, p, p, k, fk, 0);
        }
    }

    /// `Σ_i p[i]·S(q_i)` for `S` the suffix form. When the suffix bits are few, the queries are
    /// grouped by them and the suffix form is folded for every value of them at once, one
    /// variable at a time: after variable `j`, the partial fold depends only on the bits from `j`.
    function collect(uint256[] memory ctx, uint256[] memory qs, uint256[] memory p, uint256[] memory mu)
        internal
        pure
        returns (uint256 total)
    {
        uint256 f = ctx[1];
        uint256 ext = ctx[3];
        uint256 hb = ctx[6];
        if (hb > TREE_BITS) {
            for (uint256 i = 0; i < qs.length; ++i) {
                total ^= _kernel(4, ctx, qs, p, mu, qs[i], p[i], 0);
            }
            return total;
        }
        uint256[] memory buckets = new uint256[](1 << hb);
        uint256 used;
        for (uint256 i = 0; i < qs.length; ++i) {
            uint256 h = qs[i] >> f;
            if (buckets[h] == 0) ++used;
            buckets[h] ^= p[i];
        }
        if ((ext << hb) > used * ((1 << ext) - 1)) {
            for (uint256 h = 0; h < buckets.length; ++h) {
                if (buckets[h] != 0) {
                    total ^= _kernel(4, ctx, qs, p, mu, h << f, buckets[h], 0);
                }
            }
            return total;
        }
        uint256 folded = _kernel(3, ctx, qs, p, mu, 0, 0, 0);
        for (uint256 h = 0; h < buckets.length; ++h) {
            if (buckets[h] != 0) {
                uint256 v;
                assembly ("memory-safe") {
                    v := mload(add(folded, shl(5, h)))
                }
                total ^= GF2.mul256(buckets[h], v);
            }
        }
    }

