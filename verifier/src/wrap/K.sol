            case 1 {
                let lo := 0
                let hi := 0
                for { let end := add(e, shl(5, lanes)) } lt(e, end) { e := add(e, 0x20) at := add(at, 16) } {
                    let w := mload(e)
                    let v := shr(128, calldataload(at))
                    lo := xor(lo, cl(and(w, 0xffffffffffffffffffffffffffffffff), v))
                    hi := xor(hi, cl(shr(128, w), v))
