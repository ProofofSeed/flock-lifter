            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function gm(ka, kb) -> ko {
                ko := red(cl(ka, kb))
            }
            for { let i := n } gt(i, 0) { i := sub(i, 1) } {
                r := xor(gm(r, gamma), shr(128, calldataload(add(at, shl(4, sub(i, 1))))))
            }
        }
    }

    /// `Σ_j gamma^j·eq(rho^(2^-j), x)` over the 128 inverse Frobenius powers of the `n` coordinates at
    /// memory `rho`, for the `n` coordinates at memory `x`, which it overwrites.
    function twistedEq(uint256 gamma, uint256 rho, uint256 x, uint256 n) internal pure returns (uint256 acc) {
        assembly ("memory-safe") {
            function cl(ka, kb) -> ko {
                let a0 := and(ka, 0x21084210842108421084210842108421)
                let a1 := and(ka, 0x42108421084210842108421084210842)
                let a2 := and(ka, 0x84210842108421084210842108421084)
                let a3 := and(ka, 0x08421084210842108421084210842108)
                let a4 := and(ka, 0x10842108421084210842108421084210)
                let b0 := and(kb, 0x21084210842108421084210842108421)
                let b1 := and(kb, 0x42108421084210842108421084210842)
                let b2 := and(kb, 0x84210842108421084210842108421084)
                let b3 := and(kb, 0x08421084210842108421084210842108)
                let b4 := and(kb, 0x10842108421084210842108421084210)
                ko := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                ko := xor(ko, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                ko := xor(ko, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                ko := xor(ko, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                ko := xor(ko, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
            }
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function gm(ka, kb) -> ko {
                ko := red(cl(ka, kb))
            }
            function sq(ka) -> ko {
                ko := and(or(ka, shl(64, ka)), 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff)
                ko := and(or(ko, shl(32, ko)), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
                ko := and(or(ko, shl(16, ko)), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
                ko := and(or(ko, shl(8, ko)), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
                ko := and(or(ko, shl(4, ko)), 0x0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f)
                ko := and(or(ko, shl(2, ko)), 0x3333333333333333333333333333333333333333333333333333333333333333)
                ko := and(or(ko, shl(1, ko)), 0x5555555555555555555555555555555555555555555555555555555555555555)
                ko := red(ko)
            }
            let g := gamma
            let e := 1
            let len := shl(5, n)
            for { let j := 0 } lt(j, 128) { j := add(j, 1) } {
                if j {
                    for { let p := x let end := add(x, len) } lt(p, end) { p := add(p, 0x20) } {
                        mstore(p, sq(mload(p)))
                    }
                    g := sq(g)
                    e := gm(sq(e), g)
                }
                let prod := 1
                for { let i := 0 } lt(i, len) { i := add(i, 0x20) } {
                    prod := gm(prod, xor(1, xor(mload(add(rho, i)), mload(add(x, i)))))
                }
                acc := xor(sq(acc), gm(e, prod))
            }
            acc := sq(acc)
        }
    }

    /// Writes at memory `out`, per run of the `count` twelve-byte records at memory `runs`, the product
    /// of the six table entries its two cumulative heights select: `tables` holds six pointers, three
    /// for the first height's bytes and three for the second's.
    function atRuns(uint256 out, uint256 runs, uint256 count, uint256 tables) internal pure {
        assembly ("memory-safe") {
            function cl(ka, kb) -> ko {
                let a0 := and(ka, 0x21084210842108421084210842108421)
                let a1 := and(ka, 0x42108421084210842108421084210842)
                let a2 := and(ka, 0x84210842108421084210842108421084)
                let a3 := and(ka, 0x08421084210842108421084210842108)
                let a4 := and(ka, 0x10842108421084210842108421084210)
                let b0 := and(kb, 0x21084210842108421084210842108421)
                let b1 := and(kb, 0x42108421084210842108421084210842)
                let b2 := and(kb, 0x84210842108421084210842108421084)
                let b3 := and(kb, 0x08421084210842108421084210842108)
                let b4 := and(kb, 0x10842108421084210842108421084210)
                ko := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                ko := xor(ko, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                ko := xor(ko, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                ko := xor(ko, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                ko := xor(ko, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
            }
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function gm(ka, kb) -> ko {
                ko := red(cl(ka, kb))
            }
            let p0 := mload(tables)
            let p1 := mload(add(tables, 0x20))
            let p2 := mload(add(tables, 0x40))
            let q0 := mload(add(tables, 0x60))
            let q1 := mload(add(tables, 0x80))
            let q2 := mload(add(tables, 0xa0))
            for { let i := 0 } lt(i, count) { i := add(i, 1) } {
                let rec := mload(add(runs, mul(i, 12)))
                let t0 := shr(224, rec)
                let t1 := and(shr(192, rec), 0xffffffff)
                let a := gm(gm(mload(add(p0, shl(5, and(t0, 255)))), mload(add(p1, shl(5, and(shr(8, t0), 255))))), mload(add(p2, shl(5, shr(16, t0)))))
                let b := gm(gm(mload(add(q0, shl(5, and(t1, 255)))), mload(add(q1, shl(5, and(shr(8, t1), 255))))), mload(add(q2, shl(5, shr(16, t1)))))
                mstore(add(out, shl(5, i)), gm(a, b))
            }
        }
    }

    /// `Σ_runs at[run]·Σ_{columns of the run} table[column − base]` over the `count` twelve-byte run
    /// records at memory `runs`, the `len` words at memory `table` standing for the columns from `base`
    /// and every other column for zero.
    function weigh(uint256 table, uint256 base, uint256 len, uint256 runs, uint256 count, uint256 at) internal pure returns (uint256 r) {
        assembly ("memory-safe") {
            function cl(ka, kb) -> ko {
                let a0 := and(ka, 0x21084210842108421084210842108421)
                let a1 := and(ka, 0x42108421084210842108421084210842)
                let a2 := and(ka, 0x84210842108421084210842108421084)
                let a3 := and(ka, 0x08421084210842108421084210842108)
                let a4 := and(ka, 0x10842108421084210842108421084210)
                let b0 := and(kb, 0x21084210842108421084210842108421)
                let b1 := and(kb, 0x42108421084210842108421084210842)
                let b2 := and(kb, 0x84210842108421084210842108421084)
                let b3 := and(kb, 0x08421084210842108421084210842108)
                let b4 := and(kb, 0x10842108421084210842108421084210)
                ko := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                ko := xor(ko, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                ko := xor(ko, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                ko := xor(ko, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                ko := xor(ko, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
            }
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            let acc := 0
            let end := add(base, len)
            for { let i := 0 } lt(i, count) { i := add(i, 1) } {
                let rec := mload(add(runs, mul(i, 12)))
                let start := and(shr(176, rec), 0xffff)
                let last := add(start, and(shr(160, rec), 0xffff))
                if or(iszero(gt(last, base)), iszero(lt(start, end))) { continue }
                if lt(start, base) { start := base }
                if gt(last, end) { last := end }
                let sum := 0
                for { let p := add(table, shl(5, sub(start, base))) let q := add(table, shl(5, sub(last, base))) } lt(p, q) { p := add(p, 0x20) } {
                    sum := xor(sum, mload(p))
                }
                acc := xor(acc, cl(sum, mload(add(at, shl(5, i)))))
            }
            r := red(acc)
        }
    }

    /// The layout's branching program at the `2·layers` coordinates at memory `sigma`, for the `nu`
    /// row coordinates at memory `row` and the `m` dense-index coordinates at memory `index`, both
    /// zero beyond their lengths. The program reads, per layer, a bit of the row, of the dense index
    /// and of each of a column's two cumulative heights, carrying the sum of row and first height into
    /// the dense index and comparing the dense index with the second height; a state is the carry and
    /// whether the index is below the height so far.
    function boundary(uint256 row, uint256 nu, uint256 index, uint256 m, uint256 sigma, uint256 layers) internal pure returns (uint256 r) {
        assembly ("memory-safe") {
            function cl(ka, kb) -> ko {
                let a0 := and(ka, 0x21084210842108421084210842108421)
                let a1 := and(ka, 0x42108421084210842108421084210842)
                let a2 := and(ka, 0x84210842108421084210842108421084)
                let a3 := and(ka, 0x08421084210842108421084210842108)
                let a4 := and(ka, 0x10842108421084210842108421084210)
                let b0 := and(kb, 0x21084210842108421084210842108421)
                let b1 := and(kb, 0x42108421084210842108421084210842)
                let b2 := and(kb, 0x84210842108421084210842108421084)
                let b3 := and(kb, 0x08421084210842108421084210842108)
                let b4 := and(kb, 0x10842108421084210842108421084210)
                ko := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                ko := xor(ko, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                ko := xor(ko, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                ko := xor(ko, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                ko := xor(ko, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
            }
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function gm(ka, kb) -> ko {
                ko := red(cl(ka, kb))
            }
            // g[carry][below]: the weight of ending below with no carry, from the layers above.
            let g00 := 0
            let g01 := 1
            let g10 := 0
            let g11 := 0
            for { let layer := layers } gt(layer, 0) { layer := sub(layer, 1) } {
                let l := sub(layer, 1)
                let a := 0
                let b0 := 1
                if lt(l, nu) { a := mload(add(row, shl(5, l))) }
                if lt(l, m) { b0 := xor(1, mload(add(index, shl(5, l)))) }
                let c := mload(add(sigma, shl(6, l)))
                let d := mload(add(sigma, add(shl(6, l), 0x20)))
                // Per next carry: the index bit 0 or 1 against the height's bit, keeping or setting the comparison.
                let s := xor(g00, gm(d, xor(g00, g01)))
                let h000 := gm(b0, s)
                let h011 := xor(s, h000)
                let h001 := gm(b0, g01)
                let t := gm(b0, g00)
                let h010 := xor(g00, t)
                s := xor(g10, gm(d, xor(g10, g11)))
                let h100 := gm(b0, s)
                let h111 := xor(s, h100)
                let h101 := gm(b0, g11)
                t := gm(b0, g10)
                let h110 := xor(g10, t)
                // The row bit and the first height's bit: both zero, exactly one, both one.
                let both := gm(a, c)
                let none := xor(xor(1, a), xor(c, both))
                let one := xor(a, c)
                g00 := xor(xor(gm(none, h000), gm(one, h010)), gm(both, h100))
                g01 := xor(xor(gm(none, h001), gm(one, h011)), gm(both, h101))
                g10 := xor(xor(gm(none, h010), gm(one, h100)), gm(both, h110))
                g11 := xor(xor(gm(none, h011), gm(one, h101)), gm(both, h111))
            }
            r := g00
        }
    }

    /// Reads `n` sixteen-byte values at calldata `at` into words at memory `out`; returns whether each
    /// squares to the word at the same index of memory `prev`.
    function roots(uint256 out, uint256 at, uint256 prev, uint256 n) internal pure returns (bool ok) {
        assembly ("memory-safe") {
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function sq(ka) -> ko {
                ko := and(or(ka, shl(64, ka)), 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff)
                ko := and(or(ko, shl(32, ko)), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
                ko := and(or(ko, shl(16, ko)), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
                ko := and(or(ko, shl(8, ko)), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
                ko := and(or(ko, shl(4, ko)), 0x0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f)
                ko := and(or(ko, shl(2, ko)), 0x3333333333333333333333333333333333333333333333333333333333333333)
                ko := and(or(ko, shl(1, ko)), 0x5555555555555555555555555555555555555555555555555555555555555555)
                ko := red(ko)
            }
            ok := 1
            for { let i := 0 } lt(i, n) { i := add(i, 1) } {
                let v := shr(128, calldataload(add(at, shl(4, i))))
                mstore(add(out, shl(5, i)), v)
                ok := and(ok, eq(sq(v), mload(add(prev, shl(5, i)))))
            }
        }
    }

    /// Product of an extension element and a base element.
    function mul256By128(uint256 a, uint256 b) internal pure returns (uint256 r) {
        assembly ("memory-safe") {
            function cl(ka, kb) -> ko {
                let a0 := and(ka, 0x21084210842108421084210842108421)
                let a1 := and(ka, 0x42108421084210842108421084210842)
                let a2 := and(ka, 0x84210842108421084210842108421084)
                let a3 := and(ka, 0x08421084210842108421084210842108)
                let a4 := and(ka, 0x10842108421084210842108421084210)
                let b0 := and(kb, 0x21084210842108421084210842108421)
                let b1 := and(kb, 0x42108421084210842108421084210842)
                let b2 := and(kb, 0x84210842108421084210842108421084)
                let b3 := and(kb, 0x08421084210842108421084210842108)
                let b4 := and(kb, 0x10842108421084210842108421084210)
                ko := and(xor(xor(mul(a0, b0), mul(a1, b4)), xor(xor(mul(a2, b3), mul(a3, b2)), mul(a4, b1))), 0x8421084210842108421084210842108421084210842108421084210842108421)
                ko := xor(ko, and(xor(xor(mul(a0, b1), mul(a1, b0)), xor(xor(mul(a2, b4), mul(a3, b3)), mul(a4, b2))), 0x0842108421084210842108421084210842108421084210842108421084210842))
                ko := xor(ko, and(xor(xor(mul(a0, b2), mul(a1, b1)), xor(xor(mul(a2, b0), mul(a3, b4)), mul(a4, b3))), 0x1084210842108421084210842108421084210842108421084210842108421084))
                ko := xor(ko, and(xor(xor(mul(a0, b3), mul(a1, b2)), xor(xor(mul(a2, b1), mul(a3, b0)), mul(a4, b4))), 0x2108421084210842108421084210842108421084210842108421084210842108))
                ko := xor(ko, and(xor(xor(mul(a0, b4), mul(a1, b3)), xor(xor(mul(a2, b2), mul(a3, b1)), mul(a4, b0))), 0x4210842108421084210842108421084210842108421084210842108421084210))
            }
            function red(kv) -> ko {
                let h := shr(128, kv)
                ko := xor(and(kv, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
                h := shr(128, ko)
                ko := xor(and(ko, 0xffffffffffffffffffffffffffffffff), xor(xor(h, shl(1, h)), xor(shl(2, h), shl(7, h))))
            }
            function xinv(kz) -> ko {
                ko := xor(shr(1, kz), mul(and(kz, 1), 0x80000000000000000000000000000043))
            }
            function gm2(ka, kb) -> ko {
                let a0 := and(ka, 0xffffffffffffffffffffffffffffffff)
                let a1 := shr(128, ka)
                let b0 := and(kb, 0xffffffffffffffffffffffffffffffff)
                let b1 := shr(128, kb)
                let p0 := cl(a0, b0)
                let p1 := red(cl(a1, b1))
                let p2 := cl(xor(a0, a1), xor(b0, b1))
                ko := or(shl(128, red(xor(p2, p0))), xor(red(p0), xinv(p1)))
            }
            function gm21(ka, ks) -> ko {
                ko := or(shl(128, red(cl(shr(128, ka), ks))), red(cl(and(ka, 0xffffffffffffffffffffffffffffffff), ks)))
            }
            r := gm21(a, b)
        }
    }

